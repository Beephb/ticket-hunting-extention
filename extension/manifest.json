{
  "manifest_version": 3,
  "name": "Săn Vé",
  "version": "2.0",
  "description": "Bot tự động chọn vé 1Zone, Ticketbox và Cticket",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "webNavigation",
    "debugger",
    "alarms"
  ],

  "host_permissions": [
    "https://ticket.1zone.vn/*",
    "https://queue.1zone.vn/*",
    "https://prod.1zone.vn/*",
    "https://ticketbox.vn/*",
    "https://cticket.vn/*",
    "http://127.0.0.1:9279/*"
  ],

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://ticket.1zone.vn/*",
        "https://ticketbox.vn/*",
        "https://cticket.vn/*"
      ],
      "js": ["src/injected/page_bridge.js", "src/injected/network_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],

  "commands": {
    "hunt": {
      "suggested_key": { "default": "Alt+1" },
      "description": "Hunt vé"
    },
    "select_seat": {
      "suggested_key": { "default": "Alt+2" },
      "description": "Chọn ghế"
    },
    "fill_form": {
      "suggested_key": { "default": "Alt+3" },
      "description": "Điền form"
    }
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Săn Vé"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}