{
  "manifest_version": 3,
  "name": "Săn Vé Pro",
  "version": "2.0.0",
  "description": "Bot tự động chọn vé 1Zone và Ticketbox",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "webNavigation"
  ],

  "host_permissions": [
    "https://ticket.1zone.vn/*",
    "https://ticketbox.vn/*",
    "http://127.0.0.1:9279/*"
  ],

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Săn Vé Pro"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
